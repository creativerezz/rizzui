{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-demo",
  "type": "registry:block",
  "description": "Comprehensive button component demo showing all variants and sizes",
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "registry/default/blocks/button-demo/button-demo.tsx",
      "content": "\"use client\"\n\nimport { Button } from \"@/registry/default/ui/button\"\n\nexport default function ButtonDemo() {\n  return (\n    <div className=\"space-y-8 p-8\">\n      <div className=\"space-y-4\">\n        <h2 className=\"text-2xl font-bold\">Button Variants</h2>\n        <div className=\"flex flex-wrap gap-4\">\n          <Button variant=\"default\">Default</Button>\n          <Button variant=\"secondary\">Secondary</Button>\n          <Button variant=\"outline\">Outline</Button>\n          <Button variant=\"ghost\">Ghost</Button>\n          <Button variant=\"destructive\">Destructive</Button>\n          <Button variant=\"link\">Link</Button>\n        </div>\n      </div>\n\n      <div className=\"space-y-4\">\n        <h2 className=\"text-2xl font-bold\">Button Sizes</h2>\n        <div className=\"flex items-center flex-wrap gap-4\">\n          <Button size=\"sm\">Small</Button>\n          <Button size=\"md\">Medium</Button>\n          <Button size=\"lg\">Large</Button>\n        </div>\n      </div>\n\n      <div className=\"space-y-4\">\n        <h2 className=\"text-2xl font-bold\">Disabled State</h2>\n        <div className=\"flex flex-wrap gap-4\">\n          <Button disabled>Disabled Default</Button>\n          <Button variant=\"outline\" disabled>Disabled Outline</Button>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:block"
    }
  ]
}