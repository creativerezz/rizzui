{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "form-demo",
  "type": "registry:block",
  "description": "Contact form example demonstrating form components",
  "registryDependencies": [
    "button",
    "input",
    "label",
    "textarea",
    "select",
    "checkbox",
    "card"
  ],
  "files": [
    {
      "path": "registry/default/blocks/form-demo/form-demo.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { Button } from \"@/registry/default/ui/button\"\nimport { Input } from \"@/registry/default/ui/input\"\nimport { Label } from \"@/registry/default/ui/label\"\nimport { Textarea } from \"@/registry/default/ui/textarea\"\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/registry/default/ui/select\"\nimport { Checkbox } from \"@/registry/default/ui/checkbox\"\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from \"@/registry/default/ui/card\"\n\nexport default function FormDemo() {\n  const [agreed, setAgreed] = useState(false)\n\n  return (\n    <div className=\"max-w-2xl mx-auto p-8\">\n      <Card>\n        <CardHeader>\n          <CardTitle>Contact Form</CardTitle>\n          <CardDescription>Fill out this form to get in touch with us</CardDescription>\n        </CardHeader>\n        <CardContent className=\"space-y-6\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"name\">Name</Label>\n            <Input id=\"name\" placeholder=\"John Doe\" />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"email\">Email</Label>\n            <Input id=\"email\" type=\"email\" placeholder=\"john@example.com\" />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"subject\">Subject</Label>\n            <Select>\n              <SelectTrigger id=\"subject\">\n                <SelectValue placeholder=\"Select a subject\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"general\">General Inquiry</SelectItem>\n                <SelectItem value=\"support\">Support</SelectItem>\n                <SelectItem value=\"sales\">Sales</SelectItem>\n                <SelectItem value=\"feedback\">Feedback</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"message\">Message</Label>\n            <Textarea id=\"message\" placeholder=\"Your message here...\" />\n          </div>\n\n          <div className=\"flex items-center space-x-2\">\n            <Checkbox id=\"terms\" checked={agreed} onCheckedChange={(checked) => setAgreed(checked === true)} />\n            <Label htmlFor=\"terms\" className=\"text-sm font-normal cursor-pointer\">\n              I agree to the terms and conditions\n            </Label>\n          </div>\n        </CardContent>\n        <CardFooter className=\"flex justify-between\">\n          <Button variant=\"outline\">Cancel</Button>\n          <Button disabled={!agreed}>Submit</Button>\n        </CardFooter>\n      </Card>\n    </div>\n  )\n}\n",
      "type": "registry:block"
    }
  ]
}